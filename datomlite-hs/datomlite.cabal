cabal-version: 3.0
name:          datomlite
version:       0.1.0.0
synopsis:      Lightweight, immutable database — the DB is a value
description:   An append-only EAV log where the whole database is a pure value.
               Plain records are the schema, queries are typed, and time travel
               is just a pure function over the log.
homepage:      https://github.com/mattlianje/datomlite
bug-reports:   https://github.com/mattlianje/datomlite/issues
license:       Apache-2.0
license-file:  LICENSE
author:        Matthieu Court
maintainer:    matthieu.court@protonmail.com
copyright:     2026 Matthieu Court
category:      Database
build-type:    Simple

extra-source-files:
    README.md
    CHANGELOG.md

source-repository head
  type: git
  location: https://github.com/mattlianje/datomlite
  subdir: datomlite-hs

library
  exposed-modules:     Datomlite
                       Datomlite.Raw
  other-modules:       Datomlite.Core
                       Datomlite.Schema
                       Datomlite.Query
                       Datomlite.Watch
                       Datomlite.Window
  build-depends:       base >= 4.7 && < 5
                     , text >= 2.1.2 && < 2.2
                     , containers >= 0.5 && < 0.9
                     , stm >= 2.5 && < 2.6
                     , bytestring >= 0.11 && < 0.13
                     , time >= 1.9 && < 1.15
  hs-source-dirs:      .
  default-language:    Haskell2010
  ghc-options:         -Wall

test-suite datomlite-tests
  type:                exitcode-stdio-1.0
  main-is:             Test.hs
  other-modules:       Shared
  build-depends:       base >= 4.7 && < 5
                     , datomlite
                     , bytestring
                     , containers
                     , time
                     , text
                     , stm
                     , tasty >= 1.4
                     , tasty-hunit >= 0.10
  hs-source-dirs:      test
  default-language:    Haskell2010
  ghc-options:         -Wall -threaded -rtsopts -with-rtsopts=-N
