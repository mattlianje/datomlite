      <tr><td bgcolor="#ffe0e0" align="left">t3</td><td bgcolor="#ffe0e0" align="left">#3</td><td bgcolor="#ffe0e0" align="left">Issue/status</td>  <td bgcolor="#ffe0e0" align="left">"open"</td>                   <td bgcolor="#ffe0e0" align="left">−</td></tr>
      <tr><td bgcolor="#e6ffe6" align="left">t3</td><td bgcolor="#e6ffe6" align="left">#3</td><td bgcolor="#e6ffe6" align="left">Issue/status</td>  <td bgcolor="#e6ffe6" align="left">"in-progress"</td>            <td bgcolor="#e6ffe6" align="left">+</td></tr>

